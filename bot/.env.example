# Claves del bot. Este archivo es la plantilla.
#
# 1. Copia este archivo y nómbralo ".env" (en esta misma carpeta).
# 2. Pega cada valor después del signo igual, sin comillas ni espacios.
#
# El archivo ".env" está excluido de Git: nunca se sube a GitHub.
# No compartas estas claves ni las pegues en chats o capturas de pantalla.

# Binance DEMO Trading (futuros): menú de la cuenta demo -> API Management -> Create API
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Telegram (opcional): el token te lo da @BotFather al crear tu bot.
# El chat_id te lo dice el comando:  python bot/bot.py --telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
